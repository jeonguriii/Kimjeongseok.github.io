---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/profile';
import { getProject, publishedProjects } from '../../data/projects';
import { getStory, stories } from '../../data/stories';
import { withBase } from '../../utils/url';
import '../../styles/case.css';

export function getStaticPaths() {
  return publishedProjects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProject(slug!);
const story = getStory(slug!);

if (!project || !story) {
  return Astro.redirect(withBase('/'));
}

const toc = [
  ...(story.metrics ? [{ id: 'outcomes', label: '한눈에' }] : []),
  ...(story.parts
    ? story.parts.map((pt, i) => ({ id: `part-${i + 1}`, label: pt.title }))
    : story.steps.map((s) => ({ id: s.key, label: s.label }))),
  ...(story.after ? [{ id: 'after', label: story.after.label }] : []),
];

// 본문 줄을 문단과 목록으로 묶음 ('- '로 시작하면 목록)
const group = (lines: string[]) => {
  const out: { kind: 'p' | 'ul'; items: string[] }[] = [];
  for (const line of lines) {
    if (line.startsWith('- ')) {
      const last = out.at(-1);
      if (last && last.kind === 'ul') last.items.push(line.slice(2));
      else out.push({ kind: 'ul', items: [line.slice(2)] });
    } else {
      out.push({ kind: 'p', items: [line] });
    }
  }
  return out;
};

const sections = story.parts ?? [{ title: '', heading: '', steps: story.steps }];

const order = stories.map((s) => s.slug);
const others = publishedProjects
  .filter((p) => p.slug !== project.slug)
  .sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
const titleOf = (s: string) => getStory(s)?.title ?? s;
---

<BaseLayout title={`${story.title} · ${profile.name}`} description={story.heading}>
  <article class="case">
    <div class="case__progress" aria-hidden="true">
      <span data-progress></span>
    </div>

    <header class="case__hero">
      <a class="case__back" href={withBase('/#projects')}>← Projects</a>
      <div class="case__media">
        <img
          src={withBase(project.thumbnail)}
          alt=""
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
          style={`view-transition-name: project-${project.slug}`}
        />
      </div>
      <div class="case__intro case-wrap">
        <p class="meta">{story.period} · {story.meta}</p>
        <h1 class="case__title">{story.title}</h1>
        <p class="case__lead">{story.heading}</p>
        <p class="case__role">{story.role}</p>
      </div>
    </header>

    <div class="case__layout case-wrap">
      <nav class="toc" aria-label="목차">
        <p class="toc__label">Contents</p>
        <ol>
          {
            toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="case__main">
        <section class="block" aria-label="어떤 제품인가">
          <div class="block__grid">
            <h2 class="block__h">어떤 제품인가</h2>
            <div>
              <p class="block__p">{story.product}</p>
            </div>
          </div>
        </section>

        {
          story.extras ? (
            <section class="block" aria-label={story.extras.title}>
              <div class="block__grid">
                <h2 class="block__h">{story.extras.title}</h2>
                <ul class="work__list">
                  {story.extras.items.map((raw) => {
                    const it = raw.replace(/^- /, '');
                    const m = it.match(/^([^:：]{1,16}): (.*)$/);
                    return m ? (
                      <li>
                        <strong>{m[1]}</strong> — {m[2]}
                      </li>
                    ) : (
                      <li>{it}</li>
                    );
                  })}
                </ul>
              </div>
            </section>
          ) : null
        }

        {
          story.metrics ? (
            <section class="block" id="outcomes" aria-label="한눈에">
              <div class="block__grid">
                <h2 class="block__h">한눈에</h2>
                <ul class="outcomes">
                  {story.metrics.map((m) => (
                    <li>
                      <p class="outcomes__label">{m.label}</p>
                      <p class="outcomes__change">
                        <strong>{m.value}</strong>
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          ) : null
        }

        {
          sections.map((sec, si) => (
            <>
              {sec.title ? (
                <section class="block part" id={`part-${si + 1}`} aria-label={sec.title}>
                  <p class="part__no">이야기 {si + 1}</p>
                  <h2 class="part__title">{sec.title}</h2>
                  {sec.heading ? <p class="part__heading">{sec.heading}</p> : null}
                </section>
              ) : null}
              {sec.steps.map((step, n) => (
                <section
                  class:list={['block', 'step', (step.key === 'analysis' || step.key === 'result') && 'block--shift']}
                  id={sec.title ? `part-${si + 1}-${step.key}` : step.key}
                  aria-label={step.label}
                >
                  <div class="block__grid">
                    <h2 class="block__h">
                      <span class="step__n">{String(n + 1).padStart(2, '0')}</span>
                      {step.label}
                    </h2>
                    <div>
                      {group(step.body).map((g, gi) =>
                        g.kind === 'ul' ? (
                          <ul class="work__list">
                            {g.items.map((it) => {
                              const m = it.match(/^([^:：]{1,16}): (.*)$/);
                              return m ? (
                                <li>
                                  <strong>{m[1]}</strong> — {m[2]}
                                </li>
                              ) : (
                                <li>{it}</li>
                              );
                            })}
                          </ul>
                        ) : (step.key === 'problem' || step.key === 'solution') && gi === 0 && step.body.length > 1 && step.body[1].startsWith('- ') ? (
                          <p class="block__p step__lead">{g.items[0]}</p>
                        ) : (
                          <p class="block__p">{g.items[0]}</p>
                        ),
                      )}
                    </div>
                  </div>
                </section>
              ))}
            </>
          ))
        }

        {
          story.after ? (
            <section class="block" id="after" aria-label={story.after.label}>
              <div class="block__grid">
                <h2 class="block__h">{story.after.label}</h2>
                <div>
                  <p class="block__p">{story.after.text}</p>
                </div>
              </div>
            </section>
          ) : null
        }

        <section class="more" aria-label="다른 프로젝트">
          <h2 class="block__h">More projects</h2>
          <ul class="more__list">
            {
              others.map((p) => (
                <li>
                  <a href={withBase(`/projects/${p.slug}`)}>
                    <img
                      src={withBase(p.thumbnail)}
                      alt=""
                      width="640"
                      height="360"
                      loading="lazy"
                      style={`view-transition-name: project-${p.slug}`}
                    />
                    <span>{titleOf(p.slug)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="text-link" href={withBase('/#projects')}>프로젝트 목록으로</a>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .step__n {
    display: block;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--mute);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.2rem;
  }

  .step__lead {
    font-weight: 650;
    color: var(--ink);
  }

  .step[id$='result'] .block__h {
    color: var(--brass);
  }

  .part {
    padding-top: 3.5rem;
    border-top: 2px solid var(--ink);
  }

  .part__no {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    color: var(--mute);
  }

  .part__title {
    margin: 0.35rem 0 0;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .part__heading {
    margin: 0.5rem 0 0;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--teal);
  }
</style>
