---
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 링크 미리보기 이미지 (public 기준 경로) */
  image?: string;
}

const {
  title = '김정석 · Embedded Firmware Engineer',
  description = '다섯 번의 공공조명 프로젝트, 목표는 하나입니다. 무인화 시스템. 임베디드 펌웨어 엔지니어 김정석의 포트폴리오.',
  image = '/og.jpg',
} = Astro.props;

// 링크 미리보기(카카오톡·슬랙 등)는 절대 주소가 필요
const ogImage = new URL(withBase(image), Astro.site).href;
const ogUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="김정석 포트폴리오" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <ClientRouter />
  </head>
  <body>
    <!--
      THESIS: Embedded engineer portfolio — technical credibility, project depth, operational stability.
      OWN-WORLD: Slate #eef0f2 / ink #0f1419 / teal #1a4a6b / brass #c8762a; Pretendard; project-led scroll.
    -->
    <slot />
    <script>
      import '../scripts/cinema';
    </script>
  </body>
</html>
