---
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '김정석 · Embedded Firmware Engineer',
  description = '김정석 — 재사용 가능한 구조와 안정적인 시스템을 설계하는 임베디드 개발자. STM32·ESP32 · LoRaWAN · LwM2M · FOTA.',
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <ClientRouter />
  </head>
  <body>
    <!--
      THESIS: Embedded engineer portfolio — technical credibility, project depth, operational stability.
      OWN-WORLD: Slate #eef0f2 / ink #0f1419 / teal #1a4a6b / brass #c8762a; Pretendard; project-led scroll.
    -->
    <slot />
    <script>
      import '../scripts/cinema';
    </script>
  </body>
</html>
